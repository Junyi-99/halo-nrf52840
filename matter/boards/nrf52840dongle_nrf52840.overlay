/* Makerdiary nRF52840 MDK USB Dongle carrying Nordic's PCA10059 open bootloader
 * (app at 0x1000, bootloader at 0xE0000): built as nrf52840dongle/nrf52840 for
 * that flash layout, with the MDK dongle's own RGB LED and button pins. Settings
 * live in the board's storage partition (0xDC000, 16 kB); a 4 kB factory-data
 * node sits just below it. Console and shell are the board's USB CDC ACM.
 */
&led0_green {
	gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;	/* status LED: the dongle's green die */
};

&led1_red {
	gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
};

&led1_green {
	gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
};

&led1_blue {
	gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
};

&button0 {
	gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&flash0 {
	partitions {
		factory_data_partition: partition@db000 {
			label = "factory-data";
			reg = <0x000db000 0x00001000>;
		};
	};
};
